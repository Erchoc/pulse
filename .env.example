# ─── pulse server ────────────────────────────────────────
PORT=8080

# ─── PostgreSQL (本地 docker / 生产阿里云 RDS) ─────────────
# 本地默认用 5433 (避开系统自带或已有的 5432 PG 实例)；DATABASE_URL 优先
DATABASE_URL=postgres://pulse:pulse_dev@localhost:5433/pulse?sslmode=disable
PG_HOST=localhost
PG_PORT=5433
PG_USER=pulse
PG_PASSWORD=pulse_dev
PG_DATABASE=pulse
PG_SSLMODE=disable

# ─── Redis (可选, 留空则不启用缓存层) ─────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─── Auth ────────────────────────────────────────────────
# 生产环境用 `openssl rand -base64 48` 生成, 32+ 字节随机
PULSE_JWT_SECRET=change_me_in_production_32_bytes_random_here
# AES-256-GCM master key, 用于加密 identity_providers.client_secret
# 生成: openssl rand -base64 32
PULSE_SECRETS_KEY=change_me_32_bytes_base64_encoded_key_here

# ─── 实例标识 (多实例部署时每个不同) ──────────────────────
PULSE_INSTANCE_ID=pulse-01
